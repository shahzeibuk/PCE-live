# Database (this project uses Postgres via @payloadcms/db-postgres)
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public site URL — no trailing slash (production: https://pakistancurrency.com)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: hostname only, for next/image when media is on a CDN or S3 public URL
# Example: xyzabc.public.blob.vercel-storage.com or cdn.yourdomain.com
# NEXT_PUBLIC_IMAGE_HOSTNAME=

# --- Media uploads (production) ---
# Without object storage, uploads stay on disk under public/media (OK for local dev; NOT for Vercel serverless).
#
# Option A — Vercel Blob (recommended on Vercel): add Blob in Vercel dashboard; token is usually set automatically.
# BLOB_READ_WRITE_TOKEN=
# Optional — large files on Vercel serverless (see Payload docs for client uploads)
# VERCEL_BLOB_CLIENT_UPLOADS=true
#
# Option B — S3-compatible (AWS S3, Cloudflare R2, etc.). Ignored if BLOB_READ_WRITE_TOKEN is set.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Cloudflare R2: set endpoint and force path style, e.g.
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# Optional ACL — omit for many R2 setups; use public-read for public AWS objects
# S3_ACL=public-read
# Large uploads on Vercel: enable client-side uploads (requires bucket CORS for PUT from your origin)
# S3_CLIENT_UPLOADS=true  (optional — see Payload docs for S3 client uploads and bucket CORS)

# Optional: protect POST/GET /api/cron/sync-currency-rates (manual or GitHub Actions ping).
# Not required for normal operation if you rely on traffic-triggered sync below.
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Auto-refresh FX in the DB when a page loads rates and data is older than N hours (no cron).
# Set to 0 to disable (rely on Payload admin sync or /api/currency-rates/sync only). Default 12.
RATES_AUTO_SYNC_STALE_HOURS=12

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Production only: /api/.../seed endpoints return 404 unless set; then require Authorization: Bearer <this>
# SEED_ENDPOINT_SECRET=
